name: 'Full Only Self Use'
desc: |-
  Stash 2026 官方 Override 语法兼容版
  保留原订阅中的 proxies / proxy-providers
  完全替换 proxy-groups / rule-providers / rules
  集成 Tailscale；192.168.10.0/24 强制走 🏠 Tailscale；其余规则优先级：ProxyList -> DirectList -> ProxyGFWlist

proxies:
  - name: '🏠 Tailscale'
    type: tailscale
    hostname: 'stash-iphone'
    ephemeral: false

proxy-groups: #!replace
  - name: '🚀 节点选择'
    type: select
    proxies:
      - '🏠 Tailscale'
      - '实验'
      - '♻️ 自动选择'
      - '🚀 手动切换'
      - 'DIRECT'
      - '香港'
      - '台湾'
      - '新加坡'
      - '日本'
      - '美国'
      - '韩国'
      - '东南亚'
      - '西欧'
      - '小众'

  - name: '🚀 手动切换'
    type: select
    proxies:
      - '🏠 Tailscale'
    include-all: true

  - name: '♻️ 自动选择'
    type: url-test
    include-all: true
    interval: 300
    lazy: true

  - name: '💬 OpenAi'
    type: select
    proxies:
      - '台湾'
      - '新加坡'
      - '香港'
      - '日本'
      - '美国'
      - '韩国'
      - '东南亚'
      - '西欧'
      - '小众'
      - '实验'
      - '♻️ 自动选择'
      - '🚀 手动切换'
      - 'DIRECT'

  - name: 'Telegram'
    type: select
    proxies:
      - '实验'
      - '♻️ 自动选择'
      - '🚀 手动切换'
      - 'DIRECT'
      - '香港'
      - '台湾'
      - '新加坡'
      - '日本'
      - '美国'
      - '韩国'
      - '东南亚'
      - '西欧'
      - '小众'

  - name: '🎥 奈飞视频'
    type: select
    proxies:
      - '小众'
      - '🚀 节点选择'
      - '🚀 手动切换'
      - '实验'
      - '♻️ 自动选择'
      - 'DIRECT'
      - '新加坡'
      - '香港'
      - '台湾'
      - '日本'
      - '美国'
      - '韩国'
      - '东南亚'
      - '西欧'

  - name: '🌍 国外媒体'
    type: select
    proxies:
      - '实验'
      - '🚀 节点选择'
      - '🚀 手动切换'
      - '♻️ 自动选择'
      - 'DIRECT'
      - '香港'
      - '台湾'
      - '新加坡'
      - '日本'
      - '美国'
      - '韩国'
      - '东南亚'
      - '西欧'
      - '小众'

  - name: 'Ⓜ️ 微软服务'
    type: select
    proxies:
      - 'DIRECT'
      - '实验'
      - '🚀 节点选择'
      - '🚀 手动切换'
      - '美国'
      - '香港'
      - '台湾'
      - '新加坡'
      - '日本'
      - '韩国'
      - '东南亚'
      - '西欧'
      - '小众'

  - name: '🍎 苹果服务'
    type: select
    proxies:
      - 'DIRECT'
      - '实验'
      - '🚀 节点选择'
      - '🚀 手动切换'
      - '美国'
      - '香港'
      - '台湾'
      - '新加坡'
      - '日本'
      - '韩国'
      - '东南亚'
      - '西欧'
      - '小众'

  - name: '🎮 游戏平台'
    type: select
    proxies:
      - '实验'
      - 'DIRECT'
      - '🚀 节点选择'
      - '🚀 手动切换'
      - '美国'
      - '香港'
      - '台湾'
      - '新加坡'
      - '日本'
      - '韩国'
      - '东南亚'
      - '西欧'
      - '小众'

  - name: '🎯 全球直连'
    type: select
    proxies:
      - 'DIRECT'
      - '🚀 节点选择'
      - '🚀 手动切换'
      - '♻️ 自动选择'

  - name: '🐟 漏网之鱼'
    type: select
    proxies:
      - '实验'
      - 'DIRECT'
      - '🚀 节点选择'
      - '♻️ 自动选择'
      - '香港'
      - '台湾'
      - '新加坡'
      - '日本'
      - '美国'
      - '韩国'
      - '🚀 手动切换'
      - '东南亚'
      - '西欧'
      - '小众'

  - name: '实验'
    type: url-test
    include-all: true
    filter: '实验'
    interval: 300
    lazy: true

  - name: '香港'
    type: url-test
    include-all: true
    filter: '港|HK|Hong Kong'
    interval: 300
    lazy: true

  - name: '台湾'
    type: url-test
    include-all: true
    filter: '台|台湾'
    interval: 300
    lazy: true

  - name: '日本'
    type: url-test
    include-all: true
    filter: '日本|川日|东京|大阪|泉日|埼玉|沪日|深日|日|JP|Japan'
    interval: 300
    lazy: true

  - name: '美国'
    type: url-test
    include-all: true
    filter: '美|波特兰|达拉斯|俄勒冈|凤凰城|旧金山|费利蒙|拉斯维加斯|洛杉矶|圣何塞|西雅图|芝加哥|US'
    interval: 300
    lazy: true

  - name: '新加坡'
    type: url-test
    include-all: true
    filter: '新加坡|坡|狮城|Singap'
    interval: 300
    lazy: true

  - name: '韩国'
    type: url-test
    include-all: true
    filter: 'KR|Korea|KOR|首尔|韩|韓'
    interval: 300
    lazy: true

  - name: '东南亚'
    type: select
    include-all: true
    filter: '马来西亚|马来|越南|菲律宾|泰国|印度'

  - name: '西欧'
    type: select
    include-all: true
    filter: '德国|匈牙利|荷兰|英国|意大利|新西兰'

  - name: '小众'
    type: select
    include-all: true
    filter: '澳大利亚|巴西|智利|阿根廷|巴基斯坦|南非|俄罗斯|土耳其|乌克兰|以色列|阿联酋'

rule-providers: #!replace
  AI:
    behavior: classical
    format: text
    url: 'https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Ruleset/AI.list'
    interval: 86400

  OneDrive:
    behavior: classical
    format: text
    url: 'https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/OneDrive.list'
    interval: 86400

  Microsoft:
    behavior: classical
    format: text
    url: 'https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/Microsoft.list'
